# Godot 4+ specific ignores
.godot/
/android/

# Godot engine binary (keep locally, don't commit)
Godot*.exe

# Dev tooling outputs (scripts in tools/ ARE versioned; tools/.gdignore keeps Godot out)
tools/*.png

# Temp debris from test runs and tooling
_tmp_*
game_stdout.txt
game_stderr.txt
punch_extract_out.txt
*.tmp
hitch_profile_*_stdout.txt
hitch_profile_*_stderr.txt
gameplay/debug/hitch_profile.on
addons/terrain_3d/bin/~*
